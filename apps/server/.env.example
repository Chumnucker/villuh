# Better Auth
PORT=4000
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=                    # openssl rand -hex 32
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Google OAuth (AUTH-01)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (auth + comms emails per D-05)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev   # use verified domain in production

# Stripe (subscription billing per D-17 to D-25)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Optional bootstrap only: `pnpm migrate` copies these into billing_plans.stripe_price_id
# when that column is empty. After hydrate, edit prices in DB (source of truth).
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Stripe Connect (AUTH-06)
STRIPE_CLIENT_ID=                      # from Stripe Connect application setup

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database — local Docker defaults from `pnpm db:setup`
# DATABASE_URL = owner (migrations only). DATABASE_APP_URL = villuh_app (runtime, RLS).
DATABASE_URL=postgres://chum:chum_local_dev@localhost:5432/villuh
DATABASE_APP_URL=postgres://villuh_app:villuh_app_password_changeme@localhost:5432/villuh
DATABASE_OWNER_TEST_URL=postgres://chum:chum_local_dev@localhost:5432/villuh_test
DATABASE_TEST_URL=postgres://villuh_app:villuh_app_password_changeme@localhost:5432/villuh_test

# S3 property image gallery (PROP-01, D-38) — private bucket; app stores objectKey only,
# presigned GET/PUT URLs are generated at request time and never persisted
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=                           # optional — set for R2/MinIO-compatible endpoints
