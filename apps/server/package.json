{
  "name": "@villuh/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/app.ts",
  "exports": {
    ".": "./src/app.ts",
    "./app": "./src/app.ts",
    "./router": "./src/router.ts",
    "./db": "./src/db/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/auth": "./src/schema/auth.ts",
    "./schema/role-permissions": "./src/schema/role-permissions.ts",
    "./schema/plan-limits": "./src/schema/plan-limits.ts",
    "./schema/billing-plans": "./src/schema/billing-plans.ts",
    "./domain": "./src/domain/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./schemas/account": "./src/modules/account/schemas.ts",
    "./schemas/members": "./src/modules/members/schemas.ts",
    "./schemas/permissions": "./src/modules/permissions/schemas.ts",
    "./schemas/billing": "./src/modules/billing/schemas.ts",
    "./schemas/audit-log": "./src/modules/audit-log/schemas.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env --import tsx/esm src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file=.env src/migrate.ts"
  },
  "dependencies": {
    "@better-auth/infra": "^0.2.5",
    "@better-auth/stripe": "^1.6.9",
    "@react-email/components": "1.0.12",
    "@trpc/server": "^11.17.0",
    "@types/react": "^19.2.14",
    "better-auth": "1.6.9",
    "cors": "^2.8.6",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "pino": "10.3.1",
    "pino-http": "^10.0.0",
    "react": "^19.2.5",
    "resend": "6.12.2",
    "stripe": "22.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@villuh/eslint-config": "workspace:*",
    "@villuh/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^16.6.1",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.4",
    "postgres": "3.4.9",
    "tsx": "4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.5"
  }
}
