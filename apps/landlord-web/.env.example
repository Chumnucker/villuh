# Better Auth (must match apps/server/.env values exactly — same secret, same DB)
DATABASE_APP_URL=postgres://villuh_app:villuh_app_password_changeme@localhost:5432/villuh
BETTER_AUTH_SECRET=                    # MUST be identical to the Hono server's value
BETTER_AUTH_URL=http://localhost:4000

# Public client config
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
NEXT_PUBLIC_STRIPE_CLIENT_ID=ca_       # for Stripe Connect (Plan 08)

# Mapbox address autocomplete (D-22 to D-25) — public token, URL-restrict to landlord hosts.
# Missing token falls back to manual structured address fields.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
