{
  "name": "villuh",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "menu": "./scripts/menu",
    "dev": "turbo run dev",
    "dev:landlord": "turbo run dev --filter=@villuh/landlord-web",
    "dev:resident": "turbo run dev --filter=@villuh/resident-web",
    "dev:server": "turbo run dev --filter=@villuh/server",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "migrate": "turbo run migrate --filter=@villuh/server",
    "generate": "turbo run generate --filter=@villuh/server",
    "db:setup": "node scripts/setup-local-db.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "start": "turbo run start"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "turbo": "^2.10.9"
  },
  "packageManager": "pnpm@11.1.3"
}
