{
  "name": "villuh",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@villuh/web",
    "dev:server": "turbo run dev --filter=@villuh/server",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "migrate": "turbo run migrate --filter=@villuh/server",
    "generate": "turbo run generate --filter=@villuh/server",
    "start": "turbo run start"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "turbo": "^2.10.9"
  },
  "packageManager": "pnpm@11.1.3"
}
