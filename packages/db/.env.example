# Owner role — used ONLY for migrations (drizzle-kit generate/migrate)
# NEVER use this connection string in the Hono server or tests
DATABASE_URL=postgres://postgres:postgres@localhost:5432/villuh

# Non-owner role (villuh_app) — used by Hono runtime
# RLS policies are enforced when connecting as this role
DATABASE_APP_URL=postgres://villuh_app:villuh_app_password_changeme@localhost:5432/villuh

# Non-owner role — used by integration tests (same role as APP_URL, separate DB)
DATABASE_TEST_URL=postgres://villuh_app:villuh_app_password_changeme@localhost:5432/villuh_test
