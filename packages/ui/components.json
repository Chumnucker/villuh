{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-luma",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/globals.css",
    "baseColor": "zinc",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "subtle",
  "aliases": {
    "components": "@/src",
    "utils": "@/utils",
    "ui": "@/src",
    "lib": "@/utils",
    "hooks": "@/src"
  },
  "registries": {
    "@reui": "https://reui.io/r/{style}/{name}.json",
    "@coss": "https://coss.com/ui/r/{name}.json",
    "@bklit": "https://ui.bklit.com/r/{name}.json"
  }
}
